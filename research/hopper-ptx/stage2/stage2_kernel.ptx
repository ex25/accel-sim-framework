.version 7.0
.target sm_70
.address_size 64

.visible .entry stage2_kernel(
    .param .u64 stage2_in,
    .param .u64 stage2_out,
    .param .u32 stage2_n
)
{
    .reg .pred %p;
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .shared .align 4 .b32 stage2_shared[512];

    mov.u32 %r0, %tid.x;
    ld.param.u32 %r1, [stage2_n];
    setp.ge.u32 %p, %r0, %r1;
    @%p bra DONE;

    ld.param.u64 %rd0, [stage2_in];
    ld.param.u64 %rd1, [stage2_out];
    mul.wide.u32 %rd2, %r0, 4;
    add.u64 %rd3, %rd0, %rd2;
    ld.global.u32 %r2, [%rd3];
    add.u32 %r2, %r2, 7;
    add.u64 %rd4, stage2_shared, %rd2;
    st.shared.u32 [%rd4], %r2;
    bar.sync 0;
    ld.shared.u32 %r3, [%rd4];
    add.u32 %r3, %r3, %r0;
    add.u64 %rd5, %rd1, %rd2;
    st.global.u32 [%rd5], %r3;

DONE:
    ret;
}
