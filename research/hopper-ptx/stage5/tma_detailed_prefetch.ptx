.version 8.7
.target sm_90
.address_size 64
.visible .entry tma_detailed(.param .u64 out, .param .u64 descriptor, .param .u32 mask)
{
 .reg .pred %p<6>;
 .reg .b32 %r<16>;
 .reg .b64 %rd<10>;
 .shared .align 16 .b8 tile[16];
 .shared .align 8 .b8 stage5_bar[8];
 mov.u32 %r0, %tid.x;
 mov.u32 %r1, %ctaid.x;
 setp.ne.u32 %p0, %r0, 0;
 @%p0 bra EXIT;
 mov.u64 %rd0, tile;
 st.shared.u32 [%rd0], 0xcccccccc;
 st.shared.u32 [%rd0+4], 0xcccccccc;
 st.shared.u32 [%rd0+8], 0xcccccccc;
 st.shared.u32 [%rd0+12], 0xcccccccc;
 mbarrier.init.shared::cta.b64 [stage5_bar], 1;
 mbarrier.expect_tx.shared::cta.b64 [stage5_bar], 16;
 mbarrier.arrive.shared::cta.b64 %rd1, [stage5_bar];
 ld.param.u64 %rd2, [descriptor];
 ld.param.u32 %r2, [mask];
 setp.ne.u32 %p1, %r1, 0;
 @%p1 bra TARGET;
 // Harness waits until all selected CTAs have initialized at writeback.
 mov.u32 %r3, 0;
DELAY:
 add.u32 %r3, %r3, 1;
 setp.lt.u32 %p2, %r3, 80;
 @%p2 bra DELAY;
 mov.u32 %r4, 2;
 mov.u32 %r5, 0;
 mbarrier.test_wait.shared::cta.b64 %p3, [stage5_bar], %rd1;
 cp.async.bulk.prefetch.tensor.2d.L2.global [%rd2, {%r4,%r5}];
 add.u32 %r3, %r3, 1;
 add.u32 %r3, %r3, 1;
 // test_wait observes only. Snapshot demonstrates shared remains sentinel.
 mbarrier.test_wait.shared::cta.b64 %p3, [stage5_bar], %rd1;
 ld.shared.u32 %r6, [tile];
 ld.param.u64 %rd5, [out];
 selp.u32 %r12, 1, 0, %p3;
 st.global.u32 [%rd5+64], %r6;
 st.global.u32 [%rd5+68], %r12;
TARGET:
 mov.u32 %r7, 1;
 shl.b32 %r7, %r7, %r1;
 and.b32 %r7, %r7, %r2;
 setp.eq.u32 %p4, %r7, 0;
 @%p4 bra OUTPUT;
WAIT:
 mbarrier.try_wait.parity.shared::cta.b64 %p5, [stage5_bar], 0;
 @!%p5 bra WAIT;
OUTPUT:
 ld.param.u64 %rd3, [out];
 mul.wide.u32 %rd4, %r1, 16;
 add.u64 %rd3, %rd3, %rd4;
 ld.shared.u32 %r8, [tile];
 ld.shared.u32 %r9, [tile+4];
 ld.shared.u32 %r10, [tile+8];
 ld.shared.u32 %r11, [tile+12];
 st.global.u32 [%rd3], %r8;
 st.global.u32 [%rd3+4], %r9;
 st.global.u32 [%rd3+8], %r10;
 st.global.u32 [%rd3+12], %r11;
EXIT:
 ret;
}
