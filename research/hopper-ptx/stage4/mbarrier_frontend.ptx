.version 8.7
.target sm_90
.address_size 64
.visible .entry mbarrier_frontend(
    .param .u64 out
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<3>;
    .reg .b64 %rd<3>;
    .shared .align 8 .b8 stage4_bar[8];
    mov.u32 %r0, %tid.x;
    mbarrier.init.shared::cta.b64 [stage4_bar], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 %rd0, [stage4_bar], 8;
    mbarrier.expect_tx.shared::cta.b64 [stage4_bar], 8;
    mbarrier.complete_tx.shared::cta.b64 [stage4_bar], 8;
    mbarrier.pending_count.shared::cta.b64 %r1, [stage4_bar];
    mbarrier.test_wait.shared::cta.b64 %p0, [stage4_bar], %rd0;
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [stage4_bar], 1;
    mbarrier.arrive_drop.shared::cta.b64 %rd1, [stage4_bar];
    mbarrier.inval.shared::cta.b64 [stage4_bar];
    ret;
}
