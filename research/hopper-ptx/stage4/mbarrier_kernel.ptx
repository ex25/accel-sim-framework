.version 8.7
.target sm_90
.address_size 64

.visible .entry mbarrier_kernel(
    .param .u64 out
)
{
    .reg .pred %p<4>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .shared .align 8 .b8 stage4_bar[8];

    mov.u32 %r0, %tid.x;
    setp.eq.u32 %p0, %r0, 0;
    @%p0 mbarrier.init.shared::cta.b64 [stage4_bar], 32;
    bar.sync 0;

    @%p0 mbarrier.expect_tx.shared::cta.b64 [stage4_bar], 4;
    mbarrier.arrive.shared::cta.b64 %rd0, [stage4_bar];
    mbarrier.test_wait.shared::cta.b64 %p1, [stage4_bar], %rd0;
    selp.u32 %r1, 1, 0, %p1;

    @%p0 mbarrier.complete_tx.shared::cta.b64 [stage4_bar], 4;
    bar.sync 0;
    mbarrier.try_wait.parity.shared::cta.b64 %p2, [stage4_bar], 0;
    selp.u32 %r2, 10, 0, %p2;
    add.u32 %r3, %r1, %r2;

    ld.param.u64 %rd1, [out];
    mul.wide.u32 %rd2, %r0, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r3;
    ret;
}
