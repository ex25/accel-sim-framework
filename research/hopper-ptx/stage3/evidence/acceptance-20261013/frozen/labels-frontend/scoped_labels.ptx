.version 8.7
.target sm_90a
.address_size 64
.visible .entry readiness_kernel(.param .u64 out) {
 .reg .b32 %r<8>;
 .reg .b64 %rd<4>;
 .reg .pred %p;
 ld.param.u64 %rd0, [out];
 mov.b64 %rd1, 0;
 mov.u32 %r0, 0;
 mov.u32 %r1, -1;

 { bra.uni local;
   mov.u32 %r2, 99;
 local: mov.u32 %r2, 1;
 }
 { bra.uni local;
   mov.u32 %r2, 99;
 local: add.u32 %r2, %r2, 2;
 }
 mov.u32 %r6, %tid.x;
 setp.eq.u32 %p, %r6, 0;
 @%p st.global.u32 [%rd0], %r2;
 ret;
}
