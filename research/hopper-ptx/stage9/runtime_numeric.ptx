.version 8.0
.target sm_90a
.address_size 64
.visible .entry runtime_numeric(
 .param .u64 output,
 .param .u8 small,
 .param .align 16 .b8 record[16],
 .param .u32 tail
)
{
 .reg .b64 %rd<4>;
 .reg .b32 %r<10>;
 ld.param.u64 %rd0, [output];
 ld.param.u8 %r0, [small];
 ld.param.u32 %r1, [record+8];
 ld.param.u32 %r2, [tail];
 add.u32 %r3, %r0, %r1;
 add.u32 %r3, %r3, %r2;
 add.u32 %r3, %r3, 100;
 mov.u32 %r4, %tid.x;
 mov.u32 %r5, %ctaid.x;
 mov.u32 %r6, %ntid.x;
 mad.lo.u32 %r4, %r5, %r6, %r4;
 add.u32 %r3, %r3, %r4;
 mul.wide.u32 %rd1, %r4, 4;
 add.u64 %rd2, %rd0, %rd1;
 st.global.u32 [%rd2], %r3;
 ret;
}
